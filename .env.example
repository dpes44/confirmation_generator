# Aiven Postgres connection string (Service URI from the Aiven console).
# Keep the ?sslmode=require that Aiven gives you.
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require"

# Aiven's CA certificate, optional but recommended.
# Download "CA Certificate" from the Aiven console, then paste its full contents
# on one line with literal \n between lines, e.g. "-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----\n"
# If omitted, TLS is used but the server certificate is not verified.
DATABASE_CA_CERT=""

# The single shared password used to log in.
APP_PASSWORD="change-me"

# Random secret used to sign the login cookie. Generate with:  openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
